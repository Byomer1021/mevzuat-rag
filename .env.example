# .env olarak kopyalayin; .env depoya girmez.

# Hugging Face model onbellegi. Varsayilan C:\Users\<kullanici>\.cache\huggingface;
# C'de yer azsa D'ye alin. BGE-M3 tek basina ~2.2 GB.
HF_HOME=D:/.cache/huggingface

# Cevap uretimi icin dil modeli saglayicisi henuz secilmedi (docs/kararlar.md, K-005).
# Secilince anahtari buraya eklenecek.
